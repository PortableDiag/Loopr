# Copy this file to `keystore.properties` and fill in your own values to build a
# signed release. Without it, `assembleRelease` produces an unsigned APK and
# `assembleDebug` still works out of the box.
#
# Generate a key with:
#   keytool -genkeypair -v -keystore loopr-release.jks -alias loopr \
#       -keyalg RSA -keysize 2048 -validity 10000
storeFile=loopr-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=loopr
keyPassword=YOUR_KEY_PASSWORD
